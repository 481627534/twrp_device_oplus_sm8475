# PGW110 v0.6: 加 `disabled`，让这个 HAL 在 recovery 下永不启动。
# 原因见 recovery/root/init.recovery.qcom.rc 里 `on init` 的注释：
#   它用 libfs_mgr 读 TWRP 5 列格式的 /etc/recovery.fstab，/misc 匹配不到，
#   bootcontrol_init() CHECK 失败 → SIGABRT → init 每 5 秒重启一次（v0.3 起就有）。
# TWRP 不依赖 IBootControl，槽位取自 ro.boot.slot_suffix，所以停掉零代价。
service vendor.boot-qti /vendor/bin/hw/android.hardware.boot-service.qti
    class early_hal
    user root
    group root
    disabled
    seclabel u:r:recovery:s0
