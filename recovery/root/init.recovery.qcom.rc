on early-fs
    write /proc/sys/walt/sched_lib_name "recovery,Updater,updater,update_engine_sideload"
    write /proc/sys/walt/sched_lib_mask_force 255

service post-boot-script /system/bin/sh -c /vendor/bin/init.kernel.post_boot-pineapple_default_2_3_2_1.sh
    user root
    group root
    oneshot
    seclabel u:r:recovery:s0

# PGW110: 清 misc 里残留的 BCB（"boot-recovery"）。
# TWRP 自带的 ClearBootloaderMessage() 走 AOSP ReadDefaultFstab()，读不懂本机这种
# 5 列 TWRP fstab（mount_point 不在第一列是设备名），匹配不到 /misc ⇒ 静默失败。
# BCB 残留时 bootloader 每次启动都把控制权交给 recovery，表现为「TWRP 里点
# 重启→系统，还是回到 TWRP」，与 recovery 镜像内容无关（见 05_经验总结 044/054）。
service clearbcb /system/bin/sh /system/bin/clearbcb.sh
    user root
    group root
    oneshot
    seclabel u:r:recovery:s0

# PGW110 v0.6: persist 挂载兜底脚本。
# 为什么从 `exec` 改成 service：
#   v0.5 用的是 `exec -- /system/bin/sh /system/bin/mountpersist.sh`，上机后
#   /tmp/mountpersist.log 根本没生成，persist 也没挂上 —— init 侧 exec 这条路
#   在本机的 recovery init 里不可用（同一份 rc 里 clearbcb 用 service 就正常跑）。
#   改成 service + `exec_start`（Android 16 init.rc 自己在用，例如
#   `exec_start apexd-bootstrap`），语义同样是「同步执行、等进程退出再继续」，
#   保证 mount 一定早于 on boot → class_start default → recovery 主进程。
service mountpersist /system/bin/sh /system/bin/mountpersist.sh
    user root
    group root
    oneshot
    seclabel u:r:recovery:s0

on init
    setprop sys.usb.configfs 1
    # 2026-11-05：这里原来有一行 `setprop tw_disable_haptics 1`，**无效，已删**。
    #   该 property 与 GUI 读的 DataManager const `tw_disable_haptics` 是两套系统，
    #   互不相通。震动现在由 BoardConfig.mk 的 TW_NO_HAPTICS := true 从编译期关掉。
    #
    # 2026-11-05 夜（v0.6）：**删掉 `start vendor.boot-qti`**。这是从 v0.3 就一直存在的
    # 「5 秒一次 SIGABRT」崩溃循环的真凶，现场证据（logcat）：
    #   W android.hardware.boot-service.qti: [libfs_mgr] unknown flag: flags=display=misc
    #   E android.hardware.boot-service.qti: Could not read merge status:
    #                                         failed to find /misc partition
    #   F android.hardware.boot-service.qti: Check failed: bootcontrol_init()
    #   I init: Service 'vendor.boot-qti' (pid 2498) received signal 6
    # 机理：boot HAL 用 libfs_mgr 读 /etc/recovery.fstab，而那份是 **TWRP 5 列格式**
    #   （mount_point / fstype / device / 空 / flags=display=...），不是 fs_mgr 的
    #   6+ 列格式 ⇒ 每条都报 unknown flag，/misc 匹配不到 ⇒ bootcontrol_init() CHECK
    #   失败 ⇒ abort ⇒ init 按 5 秒间隔无限重启。TWRP 不需要 IBootControl
    #   （槽位走 ro.boot.slot_suffix），删掉零代价，顺带省 CPU、不再刷屏。
    start vendor.gatekeeper_default

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    chmod 0664 /dev/ion
    chown system system /dev/ion
    mkdir /mnt/vendor 0775 shell system
    mkdir /mnt/vendor/persist 0775 shell system
    # PGW110: 真挂 persist（参数照抄原厂 /vendor/etc/fstab.qcom），取代原来的 tmpfs bind。
    # 根因：TWRP 的设置文件固定写 <TW_PERSIST_DIR>/.twrp_settings，即
    #   /mnt/vendor/persist/TWRP/.twrp_settings
    # 但 TWRP 自己挂载时走 TWPartitionManager::MountByPath()，里面先经
    #   TWFunc::GetRootPath() 把路径截成第一级 ⇒ "/mnt" ⇒ 匹配不到任何分区，
    # 所以它不会自己挂 persist；而原来这里 bind 了一块 tmpfs 上去 ⇒ 设置全写进
    # 内存，重启即丢（05_经验总结 054）。这里在 init 阶段常驻挂载，TWRP 之后
    # 的读写就直接落到真实分区。
    # 2026-11-05 修正（v0.4 实测失败）：原先在这里直接写 mount，真机上**没有生效**。
    #   证据：进 TWRP 后 `/proc/mounts` 里没有 persist；日志
    #   `InfoManager file '/mnt/vendor/persist/TWRP/.twrp_settings' not found`；
    #   /mnt/vendor/persist 的时间戳是 1970 年（tmpfs）。
    #   同时确认不是被 TWRP 卸的：`twPersistUnMount()` 函数体在上游已被整行注释掉，
    #   `twPersistMount()` 又因为 MountByPath→GetRootPath 截断成 "/mnt" 挂不上。
    #   判断真因：`on fs` 触发时，by-name/persist 这条由 ueventd **异步**建立的
    #   符号链接很可能还没就绪 ⇒ mount(2) 返回 ENOENT。
    #   改法：先 wait 设备节点（最多 10 s），再 mount；若 init 的 builtin 仍不成功，
    #   由 shell 脚本兜底重试一次，并把全过程写入 /tmp/mountpersist.log 供下次判读。
    wait /dev/block/bootdevice/by-name/persist 10
    mount ext4 /dev/block/bootdevice/by-name/persist /mnt/vendor/persist noatime,nosuid,nodev,barrier=1
    # 兜底 + 留证：exec_start 是同步的（init 会等该 oneshot service 退出），
    # 所以挂载必定早于 on boot → class_start default → recovery。
    # 最坏情况：wait 10s 超时 + 脚本 sleep 5 次 = 约 15s 延迟，不会卡死。
    exec_start mountpersist
    mkdir /mnt/vendor/persist/TWRP 0775 root root
    # 启动即清 BCB，避免「重启又回 recovery」（详见上方 clearbcb service 注释）。
    start clearbcb
    install_keyring

on post-fs
    setprop twrp.variant.files_copied 0

on property:twrp.modules.loaded=true
    # Mount firmware
    mkdir /firmware
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro
    # Load ADSP firmware for PMIC
    wait /sys/kernel/boot_adsp/ssr
    write /sys/kernel/boot_adsp/ssr 1
    wait /sys/class/power_supply/battery
    start vendor.health-default
    start variant-script

on property:servicemanager.ready=true
    setprop sys.boot_completed 1
    start vendor.ssgtzd

on property:twrp.variant.files_copied=1
    start prepdecrypt.vendor
    umount /vendor
    symlink /firmware /vendor/firmware_mnt
    # PGW110: 不启动 vendor.oplus.vibrator。
    # 该 HAL 在 recovery 下初始化失败 -> init 每 5s 重启一次 -> 震动马达被反复触发，
    # 表现为「点键盘就震、停不下来」。TWRP 的震动开关 tw_disable_haptics 只是 GUI 设置，
    # 挡不住这里显式 start，所以必须从 rc 里删掉这一行。
    # 需要震动时再手动 start vendor.oplus.vibrator。
